{
  "name": "booknest-server",
  "version": "1.0.0",
  "description": "BookNest - Online Bookstore Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/init-db.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint . --max-warnings 0",
    "type-check": "node --check server.js && for f in routes/*.js middleware/*.js config/*.js scripts/*.js; do node --check \"$f\"; done",
    "test": "vitest",
    "build": "echo 'No build step needed for JS server'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^15.0.0",
    "nodemon": "^3.0.2",
    "vitest": "^1.0.0"
  }
}
